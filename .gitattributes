# These files are embedded verbatim by include_str!, so checkout EOLs become
# part of the CLI and MCP payload contract.
crates/pitstop-core/src/routing_skills/*/SKILL.md text eol=lf
crates/pitstop-core/src/routing_skills/*.md text eol=lf
crates/pitstop-consolidate/prompts/*.md text eol=lf

# Fluent catalogs are embedded too, and CLI diagnostics match them against
# source strings, so a checkout must not change their line endings.
crates/pitstop-core/locales/**/*.ftl text eol=lf

# Refinery hashes the embedded SQL bytes. Keep migration checksums identical
# across Unix and Windows checkouts, including checksum-provenance fixtures.
crates/pitstop-store/migrations/*.sql text eol=lf
crates/pitstop-store/src/testdata/*.sql text eol=lf

# Generated plugin trees, catalogs and the templates they are rendered from:
# the drift test compares bytes, and a CRLF launcher breaks `sh` on Unix
# ("/bin/sh^M"), so these stay LF on every checkout. Windows-native .ps1/.cmd
# files keep the default policy.
plugins/** text eol=lf
.claude-plugin/* text eol=lf
.agents/plugins/* text eol=lf
crates/pitstop-cli/templates/plugin/* text eol=lf
LICENSE text eol=lf
*.sh text eol=lf
install.sh text eol=lf

# Retrieval fixture integrity checks hash raw bytes on every platform.
evals/fixtures/retrieval/*.json text eol=lf
