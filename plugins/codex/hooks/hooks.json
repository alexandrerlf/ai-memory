{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/pitstop-hook\" codex session-start",
            "commandWindows": "pitstop hook --event session-start --agent codex"
          }
        ]
      }
    ],
