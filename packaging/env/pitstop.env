# Environment file read by the system pitstop.service.
#
# Keep one KEY=value assignment per line. Do not quote values unless the value
# itself contains quotes; systemd EnvironmentFile is not a shell script.
#
# Common choices:
# PITSTOP_AUTH_TOKEN=<generated with: pitstop generate-auth-token>
# PITSTOP_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# PITSTOP_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# PITSTOP_LLM_REASONING_EFFORT=low
# PITSTOP_LLM_HEADERS=x-opencode-session=host-01,x-opencode-client=pitstop
# PITSTOP_EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
