# Maintainer: AkitaOnRails <boss@akitaonrails.com>

# NOTE: pkgver/pkgrel and the sha256sums below are PLACEHOLDERS.
# `.github/workflows/release.yml` copies this file at publish time and
# rewrites all of them from the release tag before pushing to the AUR:
#
#     sed -i -e "s/^pkgver=.*/pkgver=${version}/" \
#            -e "s/^pkgrel=.*/pkgrel=1/" ...
#
# So the value here never reaches a user, and bumping it by hand fixes
# nothing while going stale again at the next release. Check the published
# package instead:
#
#     curl -s 'https://aur.archlinux.org/rpc/v5/info?arg[]=pitstop'
#
pkgname=pitstop-bin
_pkgname=pitstop
pkgver=0.3.2
pkgrel=1
pkgdesc="Local-first long-term memory MCP server for AI coding agents (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://aimemory.sh"
_repo="https://github.com/akitaonrails/ai-memory"
license=('MIT')
depends=('ca-certificates' 'gcc-libs' 'glibc')
optdepends=(
    'systemd: run pitstop as a system or user service'
)
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname" "$_pkgname-debug")
backup=('etc/pitstop/config.toml' 'etc/pitstop/env')
install=pitstop.install
options=('!strip' '!debug')

source_x86_64=("$_pkgname-$pkgver-x86_64.tar.gz::$_repo/releases/download/v$pkgver/$_pkgname-linux-x86_64.tar.gz")
sha256sums_x86_64=('SKIP')
source_aarch64=("$_pkgname-$pkgver-aarch64.tar.gz::$_repo/releases/download/v$pkgver/$_pkgname-linux-aarch64.tar.gz")
sha256sums_aarch64=('SKIP')

package() {
    install -Dm0755 pitstop "$pkgdir/usr/bin/pitstop"
    install -Dm0644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
    install -Dm0644 docs/install.md "$pkgdir/usr/share/doc/$_pkgname/install.md"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$_pkgname/LICENSE"

    install -dm0755 "$pkgdir/usr/share/pitstop"
    cp -a hooks "$pkgdir/usr/share/pitstop/"

    install -Dm0644 crates/pitstop-cli/templates/config.default.toml "$pkgdir/etc/pitstop/config.toml"
    install -Dm0640 packaging/env/pitstop.env "$pkgdir/etc/pitstop/env"
    install -Dm0644 packaging/systemd/pitstop.service "$pkgdir/usr/lib/systemd/system/pitstop.service"
    install -Dm0644 packaging/systemd/pitstop-user.service "$pkgdir/usr/lib/systemd/user/pitstop.service"
    install -Dm0644 packaging/sysusers/pitstop.conf "$pkgdir/usr/lib/sysusers.d/pitstop.conf"
    install -Dm0644 packaging/tmpfiles/pitstop.conf "$pkgdir/usr/lib/tmpfiles.d/pitstop.conf"
}
