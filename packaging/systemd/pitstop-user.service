[Unit]
Description=pitstop MCP server (user service)
Documentation=https://github.com/akitaonrails/ai-memory

[Service]
Type=simple
EnvironmentFile=-%h/.config/pitstop/env
ExecStart=/usr/bin/pitstop --data-dir %h/.local/share/pitstop --config %h/.config/pitstop/config.toml serve --transport http --enable-web
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
